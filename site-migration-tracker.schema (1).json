          "description": "Key of a Message type row in the Configuration list."
        },
        {
          "name": "SiteRefNos",
          "display": "Site Reference Nos",
          "type": "Note"
        },
        {
          "name": "SiteCount",
          "display": "Sites",
          "type": "Number",
          "decimals": 0,
          "inDefaultView": true
        },
        {
          "name": "StewardCount",
          "display": "Stewards",
          "type": "Number",
          "decimals": 0,
          "inDefaultView": true
        },
        {
          "name": "SentBy",
          "display": "Sent By",
