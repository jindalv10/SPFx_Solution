        }
      ],
      "views": []
    },
    {
      "name": "Configuration",
      "title": "Configuration",
      "description": "Business settings the team can change without redeploying: intervals, recipients, message types, links.",
      "onQuickLaunch": false,
      "titleDisplayName": "Key",
      "fields": [
        {
          "name": "ConfigValue",
          "display": "Value",
          "type": "Note",
          "inDefaultView": true
        },
        {
          "name": "Category",
          "display": "Category",
          "type": "Choice",
          "indexed": true,
          "default": "General",
          "inDefaultView": true,
          "choices": [
            "General",
            "Email",
            "Message type",
            "Links"
          ]
